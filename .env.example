# MongoDB Atlas
MONGODB_URI=

# Segredo de assinatura do JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=

# Credenciais do painel administrativo
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Blob — injetado automaticamente pela Vercel quando o store está
# conectado ao projeto. Em dev local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# OPCIONAL. Deixe vazio para servir a mídia direto do domínio público do Blob
# (https://<store-id>.public.blob.vercel-storage.com), que é o padrão.
# Preencha apenas se um dia colocar um CDN na frente do Blob.
NEXT_PUBLIC_MEDIA_BASE_URL=
