# MongoDB Atlas
MONGODB_URI=

# Segredo de assinatura do JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=

# Credenciais do painel administrativo
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Blob — injetado automaticamente pela Vercel quando o store está
# conectado ao projeto. Em dev local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# OPCIONAL — na Vercel, o mais simples é NÃO cadastrar esta variável.
# Vazia (ou ausente), a mídia é servida direto do domínio público do Blob
# (https://<store-id>.public.blob.vercel-storage.com), que é o padrão.
#
# Preencha só se colocar um CDN na frente do Blob. Nesse caso o prefixo
# NEXT_PUBLIC_ é obrigatório (é lida no browser) e não deve ser removido:
# como variável privada ela chega undefined no client e é ignorada em silêncio.
NEXT_PUBLIC_MEDIA_BASE_URL=
