# MongoDB Atlas
MONGODB_URI=

# Segredo de assinatura do JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=

# Credenciais do painel administrativo
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Blob — injetado automaticamente pela Vercel quando o store está
# conectado ao projeto. Em dev local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# CDN de mídia (Cloudflare na frente do Blob).
# Deixe vazio em dev local para servir direto do Vercel Blob.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.cantacrisopolis.com.br
